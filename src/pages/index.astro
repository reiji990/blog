---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostListItem from '@/components/PostListItem.astro'
import { getSortedPosts } from '@/lib/content'
import siteMetadata from '@/data/siteMetadata.mjs'

// app/page.tsx + app/Main.tsx の移植
const MAX_DISPLAY = 5
const posts = await getSortedPosts()

// app/page.tsx の JSON-LD（WebSite）を踏襲
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteMetadata.title,
  url: siteMetadata.siteUrl,
  description: siteMetadata.description,
}
---

<BaseLayout jsonLd={jsonLd}>
  <div class="divide-border divide-y">
    <div class="space-y-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-fg-strong text-3xl leading-9 tracking-tight sm:text-4xl sm:leading-10 md:text-6xl md:leading-14">
        最新の記事
      </h1>
      <p class="text-muted text-lg leading-7">{siteMetadata.description}</p>
    </div>
    <ul class="divide-border divide-y">
      {!posts.length && '記事がありません。'}
      {posts.slice(0, MAX_DISPLAY).map((post, i) => <PostListItem post={post} eager={i === 0} />)}
    </ul>
  </div>
  {posts.length > MAX_DISPLAY && (
    <div class="flex justify-end text-base leading-6 font-medium">
      <a href="/blog" class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400" aria-label="記事一覧">
        記事一覧 &rarr;
      </a>
    </div>
  )}
</BaseLayout>
