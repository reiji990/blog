{
  // Cloudflare Workers (静的アセット配信) の設定。
  //
  // 【このファイルが必須である理由】
  // これが無いと `wrangler deploy` はオンボーディング処理に入り、フレームワークを
  // 自動検出して余計な移行を試みる。設定を明示して自動検出を止める。
  //
  // Worker スクリプトは持たず dist/ を配信するだけなので `main` は指定しない。
  //
  // ダッシュボードの Build 設定と対応させること:
  //   Build command  : yarn build
  //   Deploy command : npx wrangler deploy
  //   Root directory : /
  "$schema": "node_modules/wrangler/config-schema.json",

  // ダッシュボードの Worker 名と一致させる
  "name": "blog",

  // ダッシュボードの Compatibility date と揃える
  "compatibility_date": "2026-07-26",

  // nodejs_compat は付けない。OpenNext の SSR 用であり、静的配信では不要
  "assets": {
    "directory": "./dist",

    // astro.config.mjs の trailingSlash: "never" に合わせる。
    // /blog/foo/ は /blog/foo へリダイレクトし dist/blog/foo/index.html を返す
    "html_handling": "drop-trailing-slash",

    // 未知のパスは Astro が出力する dist/404.html を 404 ステータスで返す
    "not_found_handling": "404-page"
  },

  // 本番 (main ブランチ) は独自ドメイン reiji990.blog のみで配信する。
  // 既定の true のままだと blog.<subdomain>.workers.dev でも同じ内容が見え、
  // 独自ドメインと重複してしまう。canonical は全ページで reiji990.blog を
  // 指しているので致命的ではないが、索引対象を1つに絞るため無効化する。
  "workers_dev": false,

  // dev ブランチなど非本番ブランチのビルドに
  // <version>-blog.<subdomain>.workers.dev のプレビュー URL を発行する。
  // 既定は false なので明示的に有効化しないと dev の確認先が無い。
  "preview_urls": true,

  "observability": {
    "enabled": true
  }
}
