{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "data/**/*.js", "astro.config.mjs"],
  "exclude": ["dist", "out", ".next", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/layouts/*": ["src/layouts/*"],
      "@/lib/*": ["src/lib/*"],
      "@/data/*": ["data/*"],
      "@/css/*": ["css/*"]
    },
    "allowJs": true,
    "verbatimModuleSyntax": false
  }
}
