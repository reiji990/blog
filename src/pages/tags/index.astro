---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Tag from '@/components/Tag.astro'
import { getSortedTags, displayTag } from '@/lib/tags'
import { getSortedPosts } from '@/lib/content'

// app/tags/page.tsx の移植
const sortedTags = await getSortedTags()
const allPosts = await getSortedPosts()
---
<BaseLayout title="Tags" description="Things I blog about">
  <div class="divide-border flex flex-col items-start justify-start divide-y md:mt-24 md:flex-row md:items-center md:justify-center md:space-x-6 md:divide-y-0">
    <div class="space-x-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-fg-strong text-3xl leading-9 tracking-tight sm:text-4xl sm:leading-10 md:border-r-2 md:px-6 md:text-6xl md:leading-14">
        Tags
      </h1>
    </div>
    <div class="flex max-w-lg flex-wrap">
      {sortedTags.length === 0 && 'No tags found.'}
      {sortedTags.map(([tagSlug, count]) => (
        <div class="mt-2 mr-5 mb-2">
          <Tag text={displayTag(allPosts, tagSlug)} />
          <a
            href={`/tags/${encodeURIComponent(tagSlug)}`}
            class="text-fg -ml-2 text-sm font-semibold uppercase"
            aria-label={`View posts tagged ${tagSlug}`}
          >
            {` (${count})`}
          </a>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
