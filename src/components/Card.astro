---
// components/Card.tsx の移植（表示のみ）
interface Props { title: string; description?: string; imgSrc?: string; href?: string }
const { title, description, imgSrc, href } = Astro.props
const imgClass = 'object-cover object-center md:h-36 lg:h-48'
---
<div class="md max-w-[544px] p-4 md:w-1/2">
  <div class={`${imgSrc ? 'h-full' : ''} border-border/60 overflow-hidden rounded-md border-2`}>
    {imgSrc && (href ? (
      <a href={href} aria-label={`Link to ${title}`}>
        <img alt={title} src={imgSrc} class={imgClass} width="544" height="306" />
      </a>
    ) : (
      <img alt={title} src={imgSrc} class={imgClass} width="544" height="306" />
    ))}
    <div class="p-6">
      <h2 class="mb-3 text-2xl leading-8 font-bold tracking-tight">
        {href ? <a href={href} aria-label={`Link to ${title}`}>{title}</a> : title}
      </h2>
      <p class="prose text-muted mb-3 max-w-none">{description}</p>
      {href && (
        <a href={href} class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400 text-base leading-6 font-medium" aria-label={`Link to ${title}`}>
          Learn more &rarr;
        </a>
      )}
    </div>
  </div>
</div>
