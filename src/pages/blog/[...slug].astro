---
import { render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { mdxComponents } from '@/components/mdxComponents'
import { toToc } from '@/lib/toc'
import { getSortedPosts } from '@/lib/content'

// 【重要】draft: true の記事を出力しないこと。
// Next 版は generateStaticParams が下書きも返すため静的ファイル自体は
// 生成されるが、ページ本体が notFound() を返すので中身は 404 ページだった
// （200 を返す soft 404）。getSortedPosts は本番ビルドでのみ draft を落とすので、
// Astro ではファイル自体が生成されず、Cloudflare の not_found_handling に
// よって正しい 404 ステータスが返る。
// 現在 draft の記事: fire / Converting-Python-files-to-exe /
// music-player-using-python-VLC
export async function getStaticPaths() {
  const posts = await getSortedPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const toc = toToc(headings)
---

<BaseLayout title={post.data.title}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 xl:max-w-5xl xl:px-0">
    <article>
      <h1 class="text-3xl leading-9 font-extrabold tracking-tight sm:text-4xl sm:leading-10">
        {post.data.title}
      </h1>
      <div class="prose dark:prose-invert mx-auto w-full pt-10 pb-8">
        <Content components={mdxComponents} toc={toc} />
      </div>
    </article>
  </div>
</BaseLayout>
